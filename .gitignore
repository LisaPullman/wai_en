# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地 skill 包 + 资产管线临时输出 + npm 本地缓存
/TTS skill/
/schnell skill/
/.npm-cache/
/scripts/.gen_audio_report.json
/scripts/__pycache__/
/scripts/*.pyc
# schnell skill staging 目录（生成时的临时中转）
/public/images/.staging/
/public/images/*/.staging/
