      "sentences": [
        { "id": "g12-01", "text": "Let's go out!", "zh": "我们出门吧！" },
        { "id": "g12-02", "text": "Where are we going?", "zh": "我们去哪里？" },
        { "id": "g12-03", "text": "Let's take a bus.", "zh": "我们坐公交车吧。" },
        { "id": "g12-04", "text": "Here comes the bus!", "zh": "公交车来了！" },
        { "id": "g12-05", "text": "Be careful!", "zh": "小心！" },
