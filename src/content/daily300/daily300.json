        { "id": "g12-13", "text": "Let's go!", "zh": "我们走吧！" },
        { "id": "g12-14", "text": "Where is the park?", "zh": "公园在哪里？" },
        { "id": "g12-15", "text": "It's over there.", "zh": "在那边。" },
        { "id": "g12-16", "text": "Turn left.", "zh": "向左转。" },
        { "id": "g12-17", "text": "Turn right.", "zh": "向右转。" },
        { "id": "g12-18", "text": "Go straight.", "zh": "直走。" },
