      "sentences": [
        { "id": "g14-01", "text": "Let's count!", "zh": "我们数数吧！" },
        { "id": "g14-02", "text": "One, two, three!", "zh": "一、二、三！" },
        { "id": "g14-03", "text": "Four, five, six!", "zh": "四、五、六！" },
        { "id": "g14-04", "text": "Seven, eight, nine, ten!", "zh": "七、八、九、十！" },
        { "id": "g14-05", "text": "How many apples?", "zh": "有几个苹果？" },
        { "id": "g14-06", "text": "Three apples!", "zh": "三个苹果！" },
        { "id": "g14-07", "text": "I have two hands.", "zh": "我有两只手。" },
        { "id": "g14-08", "text": "Red and yellow and pink.", "zh": "红色、黄色和粉色。" },
        { "id": "g14-09", "text": "What's your favorite color?", "zh": "你最喜欢什么颜色？" },
        { "id": "g14-10", "text": "My favorite color is blue.", "zh": "我最喜欢的颜色是蓝色。" },
        { "id": "g14-11", "text": "The sun is yellow.", "zh": "太阳是黄色的。" },
        { "id": "g14-12", "text": "The grass is green.", "zh": "草是绿色的。" },
        { "id": "g14-13", "text": "The cloud is white.", "zh": "云是白色的。" },
        { "id": "g14-14", "text": "I can see five birds.", "zh": "我能看到五只鸟。" },
        { "id": "g14-15", "text": "Six plus one is seven.", "zh": "六加一等于七。" },
        { "id": "g14-16", "text": "Let's count again.", "zh": "我们再数一遍。" },
        { "id": "g14-17", "text": "How old is your sister?", "zh": "你姐姐几岁？" },
        { "id": "g14-18", "text": "She is ten.", "zh": "她十岁。" },
        { "id": "g14-19", "text": "A big number!", "zh": "好大的数字！" },
        { "id": "g14-20", "text": "Numbers are fun!", "zh": "数字真有趣！" }
      ]
    },
    {
