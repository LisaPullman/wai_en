        { "id": "g13-16", "text": "What a good kid!", "zh": "真是个好孩子！" },
        { "id": "g13-17", "text": "Speak quietly, please.", "zh": "请小声说话。" },
        { "id": "g13-18", "text": "Wait a moment.", "zh": "稍等一下。" },
