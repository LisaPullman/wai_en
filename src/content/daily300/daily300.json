{
  "themes": [
    {
      "id": "g01", "title": "Greetings", "titleZh": "问候打招呼", "emoji": "👋",
      "sentences": [
        { "id": "g01-01", "text": "Good morning.", "zh": "早上好。" },
        { "id": "g01-02", "text": "Good afternoon.", "zh": "下午好。" },
        { "id": "g01-03", "text": "Good evening.", "zh": "晚上好。" },
        { "id": "g01-04", "text": "Good night.", "zh": "晚安。" },
        { "id": "g01-05", "text": "Hello!", "zh": "你好！" },
        { "id": "g01-06", "text": "Hi!", "zh": "嗨！" },
        { "id": "g01-07", "text": "How are you?", "zh": "你好吗？" },
        { "id": "g01-08", "text": "I'm fine, thank you.", "zh": "我很好，谢谢。" },
        { "id": "g01-09", "text": "Nice to meet you.", "zh": "很高兴认识你。" },
        { "id": "g01-10", "text": "See you tomorrow.", "zh": "明天见。" },
        { "id": "g01-11", "text": "Goodbye!", "zh": "再见！" },
        { "id": "g01-12", "text": "Bye-bye!", "zh": "拜拜！" },
        { "id": "g01-13", "text": "See you later.", "zh": "回头见。" },
        { "id": "g01-14", "text": "What's your name?", "zh": "你叫什么名字？" },
        { "id": "g01-15", "text": "My name is Lily.", "zh": "我叫莉莉。" },
        { "id": "g01-16", "text": "How old are you?", "zh": "你几岁了？" },
        { "id": "g01-17", "text": "I am seven years old.", "zh": "我七岁了。" },
        { "id": "g01-18", "text": "Where are you going?", "zh": "你去哪儿？" },
        { "id": "g01-19", "text": "I'm going to school.", "zh": "我去上学。" },
        { "id": "g01-20", "text": "Have a nice day!", "zh": "祝你今天愉快！" }
      ]
    },
    {
      "id": "g02", "title": "My Family", "titleZh": "我的家庭", "emoji": "👨‍👩‍👧",
      "sentences": [
        { "id": "g02-01", "text": "This is my family.", "zh": "这是我的家人。" },
        { "id": "g02-02", "text": "This is my dad.", "zh": "这是我爸爸。" },
        { "id": "g02-03", "text": "This is my mom.", "zh": "这是我妈妈。" },
        { "id": "g02-04", "text": "This is my brother.", "zh": "这是我哥哥。" },
        { "id": "g02-05", "text": "This is my sister.", "zh": "这是我姐姐。" },
        { "id": "g02-06", "text": "I love my family.", "zh": "我爱我的家。" },
        { "id": "g02-07", "text": "I love Mom and Dad.", "zh": "我爱爸爸妈妈。" },
        { "id": "g02-08", "text": "My grandma is kind.", "zh": "我的奶奶很和蔼。" },
        { "id": "g02-09", "text": "My grandpa is tall.", "zh": "我爷爷很高。" },
        { "id": "g02-10", "text": "We are a happy family.", "zh": "我们是快乐的一家人。" },
        { "id": "g02-11", "text": "Mom, where are you?", "zh": "妈妈，你在哪里？" },
        { "id": "g02-12", "text": "I'm here!", "zh": "我在这里！" },
        { "id": "g02-13", "text": "Come here, please.", "zh": "请过来。" },
        { "id": "g02-14", "text": "Give me a hug!", "zh": "抱抱我！" },
        { "id": "g02-15", "text": "Good night, Mom.", "zh": "晚安，妈妈。" },
        { "id": "g02-16", "text": "Dad is cooking.", "zh": "爸爸在做饭。" },
        { "id": "g02-17", "text": "Mom is reading.", "zh": "妈妈在看书。" },
        { "id": "g02-18", "text": "Let's play together!", "zh": "我们一起玩吧！" },
        { "id": "g02-19", "text": "I miss you.", "zh": "我想你。" },
        { "id": "g02-20", "text": "Family time is fun.", "zh": "家庭时光真有趣。" }
      ]
    },
    {
      "id": "g03", "title": "At School", "titleZh": "在学校", "emoji": "🏫",
      "sentences": [
        { "id": "g03-01", "text": "Let's go to school.", "zh": "我们去上学吧。" },
        { "id": "g03-02", "text": "Welcome to school!", "zh": "欢迎来到学校！" },
        { "id": "g03-03", "text": "This is my teacher.", "zh": "这是我的老师。" },
        { "id": "g03-04", "text": "Good morning, teacher!", "zh": "老师，早上好！" },
        { "id": "g03-05", "text": "Stand up, please.", "zh": "请起立。" },
        { "id": "g03-06", "text": "Sit down, please.", "zh": "请坐下。" },
        { "id": "g03-07", "text": "Open your book.", "zh": "打开你的书。" },
        { "id": "g03-08", "text": "Close your book.", "zh": "合上你的书。" },
        { "id": "g03-09", "text": "Listen carefully.", "zh": "认真听。" },
        { "id": "g03-10", "text": "Look at the blackboard.", "zh": "看黑板。" },
        { "id": "g03-11", "text": "Raise your hand.", "zh": "举手。" },
        { "id": "g03-12", "text": "May I come in?", "zh": "我可以进来吗？" },
        { "id": "g03-13", "text": "May I go out?", "zh": "我可以出去吗？" },
        { "id": "g03-14", "text": "I don't know.", "zh": "我不知道。" },
        { "id": "g03-15", "text": "I know the answer!", "zh": "我知道答案！" },
        { "id": "g03-16", "text": "Well done!", "zh": "做得好！" },
        { "id": "g03-17", "text": "Try again.", "zh": "再试一次。" },
        { "id": "g03-18", "text": "Time for class!", "zh": "上课时间到！" },
        { "id": "g03-19", "text": "Class is over.", "zh": "下课了。" },
        { "id": "g03-20", "text": "See you, teacher!", "zh": "老师，再见！" }
      ]
    },
    {
      "id": "g04", "title": "In Class", "titleZh": "课堂学习", "emoji": "✏️",
      "sentences": [
        { "id": "g04-01", "text": "I have a pencil.", "zh": "我有一支铅笔。" },
        { "id": "g04-02", "text": "I have an eraser.", "zh": "我有一块橡皮。" },
        { "id": "g04-03", "text": "This is my ruler.", "zh": "这是我的尺子。" },
        { "id": "g04-04", "text": "Where is my schoolbag?", "zh": "我的书包在哪里？" },
        { "id": "g04-05", "text": "Here it is.", "zh": "在这里。" },
        { "id": "g04-06", "text": "I can count to ten.", "zh": "我能数到十。" },
        { "id": "g04-07", "text": "Let's read together.", "zh": "我们一起读吧。" },
        { "id": "g04-08", "text": "Let's write together.", "zh": "我们一起写吧。" },
        { "id": "g04-09", "text": "What color is it?", "zh": "它是什么颜色？" },
        { "id": "g04-10", "text": "It's red.", "zh": "它是红色的。" },
        { "id": "g04-11", "text": "What's this?", "zh": "这是什么？" },
        { "id": "g04-12", "text": "It's a letter.", "zh": "这是一个字母。" },
        { "id": "g04-13", "text": "A is for apple.", "zh": "A 代表苹果。" },
        { "id": "g04-14", "text": "Spell it, please.", "zh": "请拼出来。" },
        { "id": "g04-15", "text": "C-A-T, cat!", "zh": "C-A-T，猫！" },
        { "id": "g04-16", "text": "Good job!", "zh": "干得好！" },
        { "id": "g04-17", "text": "Can you say it?", "zh": "你会读吗？" },
        { "id": "g04-18", "text": "Yes, I can!", "zh": "是的，我会！" },
        { "id": "g04-19", "text": "Let me try!", "zh": "让我试试！" },
        { "id": "g04-20", "text": "I did it!", "zh": "我做到了！" }
      ]
    },
    {
      "id": "g05", "title": "Eating", "titleZh": "吃饭时光", "emoji": "🍚",
      "sentences": [
        { "id": "g05-01", "text": "I'm hungry.", "zh": "我饿了。" },
        { "id": "g05-02", "text": "I'm thirsty.", "zh": "我渴了。" },
        { "id": "g05-03", "text": "It's time for dinner.", "zh": "该吃晚饭了。" },
        { "id": "g05-04", "text": "Wash your hands first.", "zh": "先洗手。" },
        { "id": "g05-05", "text": "What's for dinner?", "zh": "晚饭吃什么？" },
        { "id": "g05-06", "text": "Rice, please.", "zh": "请给我米饭。" },
        { "id": "g05-07", "text": "Do you like noodles?", "zh": "你喜欢面条吗？" },
        { "id": "g05-08", "text": "Yes, I do.", "zh": "是的，我喜欢。" },
        { "id": "g05-09", "text": "No, I don't.", "zh": "不，我不喜欢。" },
        { "id": "g05-10", "text": "Have some vegetables.", "zh": "吃点蔬菜。" },
        { "id": "g05-11", "text": "Yummy!", "zh": "真好吃！" },
        { "id": "g05-12", "text": "It's delicious!", "zh": "太美味了！" },
        { "id": "g05-13", "text": "I want more, please.", "zh": "请再给我一些。" },
        { "id": "g05-14", "text": "No more, thank you.", "zh": "不要了，谢谢。" },
        { "id": "g05-15", "text": "I'm full.", "zh": "我吃饱了。" },
        { "id": "g05-16", "text": "Drink some water.", "zh": "喝点水。" },
        { "id": "g05-17", "text": "Milk is good for you.", "zh": "牛奶对你有好处。" },
        { "id": "g05-18", "text": "Help me, please.", "zh": "请帮帮我。" },
        { "id": "g05-19", "text": "Set the table, please.", "zh": "请摆好餐具。" },
        { "id": "g05-20", "text": "Thank you, Mom!", "zh": "谢谢妈妈！" }
      ]
    },
    {
      "id": "g06", "title": "Food & Fruit", "titleZh": "水果食物", "emoji": "🍎",
      "sentences": [
        { "id": "g06-01", "text": "I like apples.", "zh": "我喜欢苹果。" },
        { "id": "g06-02", "text": "I like bananas.", "zh": "我喜欢香蕉。" },
        { "id": "g06-03", "text": "Do you want a peach?", "zh": "你想要一个桃子吗？" },
        { "id": "g06-04", "text": "An orange, please.", "zh": "请给我一个橙子。" },
        { "id": "g06-05", "text": "The watermelon is sweet.", "zh": "西瓜很甜。" },
        { "id": "g06-06", "text": "Grapes are purple.", "zh": "葡萄是紫色的。" },
        { "id": "g06-07", "text": "I want an egg.", "zh": "我想要一个鸡蛋。" },
        { "id": "g06-08", "text": "Bread and milk, please.", "zh": "请给我面包和牛奶。" },
        { "id": "g06-09", "text": "I like cake!", "zh": "我喜欢蛋糕！" },
        { "id": "g06-10", "text": "Cake is sweet.", "zh": "蛋糕很甜。" },
        { "id": "g06-11", "text": "Fish is yummy.", "zh": "鱼很好吃。" },
        { "id": "g06-12", "text": "Chicken is good.", "zh": "鸡肉很好。" },
        { "id": "g06-13", "text": "I don't like peppers.", "zh": "我不喜欢辣椒。" },
        { "id": "g06-14", "text": "What's your favorite fruit?", "zh": "你最喜欢什么水果？" },
        { "id": "g06-15", "text": "My favorite fruit is mango.", "zh": "我最喜欢的水果是芒果。" },
        { "id": "g06-16", "text": "Try one bite.", "zh": "尝一口。" },
        { "id": "g06-17", "text": "It tastes good!", "zh": "味道真好！" },
        { "id": "g06-18", "text": "An apple a day.", "zh": "一天一个苹果。" },
        { "id": "g06-19", "text": "Don't eat too much candy.", "zh": "不要吃太多糖。" },
        { "id": "g06-20", "text": "Ice cream is cold.", "zh": "冰淇淋是凉的。" }
      ]
    },
    {
      "id": "g07", "title": "Playing", "titleZh": "一起玩耍", "emoji": "⚽",
      "sentences": [
        { "id": "g07-01", "text": "Let's play!", "zh": "我们玩吧！" },
        { "id": "g07-02", "text": "Let's play ball!", "zh": "我们玩球吧！" },
        { "id": "g07-03", "text": "Catch the ball!", "zh": "接住球！" },
        { "id": "g07-04", "text": "Throw it to me!", "zh": "扔给我！" },
        { "id": "g07-05", "text": "Run fast!", "zh": "快跑！" },
        { "id": "g07-06", "text": "Jump high!", "zh": "跳高！" },
        { "id": "g07-07", "text": "Let's jump together!", "zh": "我们一起跳吧！" },
        { "id": "g07-08", "text": "I can hop!", "zh": "我能单脚跳！" },
        { "id": "g07-09", "text": "Let's ride bikes.", "zh": "我们骑自行车吧。" },
        { "id": "g07-10", "text": "I can swim.", "zh": "我会游泳。" },
        { "id": "g07-11", "text": "It's my turn.", "zh": "轮到我了。" },
        { "id": "g07-12", "text": "It's your turn.", "zh": "轮到你了。" },
        { "id": "g07-13", "text": "Wait for me!", "zh": "等等我！" },
        { "id": "g07-14", "text": "Follow me!", "zh": "跟着我！" },
        { "id": "g07-15", "text": "Come and play with me.", "zh": "来和我一起玩。" },
        { "id": "g07-16", "text": "Let's play hide-and-seek.", "zh": "我们玩捉迷藏吧。" },
        { "id": "g07-17", "text": "Where are you hiding?", "zh": "你藏在哪里？" },
        { "id": "g07-18", "text": "I found you!", "zh": "我找到你了！" },
        { "id": "g07-19", "text": "That was fun!", "zh": "真好玩！" },
        { "id": "g07-20", "text": "Let's play again!", "zh": "我们再玩一次吧！" }
      ]
    },
    {
      "id": "g08", "title": "Toys & Games", "titleZh": "玩具游戏", "emoji": "🪀",
      "sentences": [
        { "id": "g08-01", "text": "I have a ball.", "zh": "我有一个球。" },
        { "id": "g08-02", "text": "My kite can fly.", "zh": "我的风筝会飞。" },
        { "id": "g08-03", "text": "Look at my robot!", "zh": "看我的机器人！" },
        { "id": "g08-04", "text": "The doll is pretty.", "zh": "娃娃很漂亮。" },
        { "id": "g08-05", "text": "I like my teddy bear.", "zh": "我喜欢我的泰迪熊。" },
        { "id": "g08-06", "text": "Let's build blocks.", "zh": "我们搭积木吧。" },
        { "id": "g08-07", "text": "A tall tower!", "zh": "好高的塔！" },
        { "id": "g08-08", "text": "It's falling down!", "zh": "它倒下来了！" },
        { "id": "g08-09", "text": "Can I play with you?", "zh": "我能和你玩吗？" },
        { "id": "g08-10", "text": "Share your toys, please.", "zh": "请分享你的玩具。" },
        { "id": "g08-11", "text": "Here you are.", "zh": "给你。" },
        { "id": "g08-12", "text": "Thank you!", "zh": "谢谢！" },
        { "id": "g08-13", "text": "You're welcome.", "zh": "不客气。" },
        { "id": "g08-14", "text": "Let's draw a picture.", "zh": "我们画画吧。" },
        { "id": "g08-15", "text": "I can draw a cat.", "zh": "我会画一只猫。" },
        { "id": "g08-16", "text": "What a nice picture!", "zh": "多好看的画呀！" },
        { "id": "g08-17", "text": "Let me see!", "zh": "让我看看！" },
        { "id": "g08-18", "text": "It's a puzzle.", "zh": "这是一个拼图。" },
        { "id": "g08-19", "text": "Put it here.", "zh": "放在这里。" },
        { "id": "g08-20", "text": "We did it together!", "zh": "我们一起做到了！" }
      ]
    },
    {
      "id": "g09", "title": "Feelings", "titleZh": "身体感受", "emoji": "😊",
      "sentences": [
        { "id": "g09-01", "text": "I'm happy.", "zh": "我很开心。" },
        { "id": "g09-02", "text": "Are you happy?", "zh": "你开心吗？" },
        { "id": "g09-03", "text": "I'm sad.", "zh": "我很难过。" },
        { "id": "g09-04", "text": "Don't be sad.", "zh": "别难过。" },
        { "id": "g09-05", "text": "I'm tired.", "zh": "我累了。" },
        { "id": "g09-06", "text": "I'm sleepy.", "zh": "我困了。" },
        { "id": "g09-07", "text": "I'm hot.", "zh": "我很热。" },
        { "id": "g09-08", "text": "I'm cold.", "zh": "我很冷。" },
        { "id": "g09-09", "text": "My head hurts.", "zh": "我头疼。" },
        { "id": "g09-10", "text": "I feel sick.", "zh": "我不舒服。" },
        { "id": "g09-11", "text": "Are you OK?", "zh": "你还好吗？" },
        { "id": "g09-12", "text": "I'm OK.", "zh": "我没事。" },
        { "id": "g09-13", "text": "Don't cry.", "zh": "别哭。" },
        { "id": "g09-14", "text": "Smile, please!", "zh": "笑一笑！" },
        { "id": "g09-15", "text": "I'm not afraid!", "zh": "我不怕！" },
        { "id": "g09-16", "text": "Be brave!", "zh": "勇敢点！" },
        { "id": "g09-17", "text": "Give me five!", "zh": "击个掌！" },
        { "id": "g09-18", "text": "I'm excited!", "zh": "我好激动！" },
        { "id": "g09-19", "text": "I'm angry.", "zh": "我生气了。" },
        { "id": "g09-20", "text": "Take a deep breath.", "zh": "深呼吸。" }
      ]
    },
    {
      "id": "g10", "title": "Daily Routine", "titleZh": "作息时间", "emoji": "⏰",
      "sentences": [
        { "id": "g10-01", "text": "Wake up!", "zh": "醒醒！" },
        { "id": "g10-02", "text": "Get up, please.", "zh": "请起床。" },
        { "id": "g10-03", "text": "It's seven o'clock.", "zh": "七点了。" },
        { "id": "g10-04", "text": "Brush your teeth.", "zh": "刷牙。" },
        { "id": "g10-05", "text": "Wash your face.", "zh": "洗脸。" },
        { "id": "g10-06", "text": "Get dressed.", "zh": "穿衣服。" },
        { "id": "g10-07", "text": "Put on your shoes.", "zh": "穿上鞋。" },
        { "id": "g10-08", "text": "Time for breakfast.", "zh": "该吃早饭了。" },
        { "id": "g10-09", "text": "Hurry up!", "zh": "快点！" },
        { "id": "g10-10", "text": "Don't be late.", "zh": "别迟到。" },
        { "id": "g10-11", "text": "Let's go home.", "zh": "我们回家吧。" },
        { "id": "g10-12", "text": "Do your homework.", "zh": "做你的作业。" },
        { "id": "g10-13", "text": "Time for bed.", "zh": "该睡觉了。" },
        { "id": "g10-14", "text": "Take a bath.", "zh": "洗个澡。" },
        { "id": "g10-15", "text": "Turn off the light.", "zh": "关灯。" },
        { "id": "g10-16", "text": "Sweet dreams!", "zh": "做个好梦！" },
        { "id": "g10-17", "text": "It's late.", "zh": "很晚了。" },
        { "id": "g10-18", "text": "What time is it?", "zh": "几点了？" },
        { "id": "g10-19", "text": "It's time to play.", "zh": "玩耍时间到了。" },
        { "id": "g10-20", "text": "One more minute!", "zh": "再等一分钟！" }
      ]
    },
    {
      "id": "g11", "title": "Weather & Seasons", "titleZh": "天气季节", "emoji": "☀️",
      "sentences": [
        { "id": "g11-01", "text": "It's sunny today.", "zh": "今天天气晴朗。" },
        { "id": "g11-02", "text": "It's raining.", "zh": "下雨了。" },
        { "id": "g11-03", "text": "It's windy.", "zh": "风很大。" },
        { "id": "g11-04", "text": "It's snowing!", "zh": "下雪了！" },
        { "id": "g11-05", "text": "It's cloudy.", "zh": "天阴了。" },
        { "id": "g11-06", "text": "Put on your coat.", "zh": "穿上外套。" },
        { "id": "g11-07", "text": "Take an umbrella.", "zh": "带上雨伞。" },
        { "id": "g11-08", "text": "I like sunny days.", "zh": "我喜欢晴天。" },
        { "id": "g11-09", "text": "I like snowy days.", "zh": "我喜欢下雪天。" },
        { "id": "g11-10", "text": "Let's make a snowman.", "zh": "我们堆雪人吧。" },
        { "id": "g11-11", "text": "Spring is warm.", "zh": "春天很温暖。" },
        { "id": "g11-12", "text": "Summer is hot.", "zh": "夏天很热。" },
        { "id": "g11-13", "text": "Autumn is cool.", "zh": "秋天很凉爽。" },
        { "id": "g11-14", "text": "Winter is cold.", "zh": "冬天很冷。" },
        { "id": "g11-15", "text": "The sky is blue.", "zh": "天空是蓝色的。" },
        { "id": "g11-16", "text": "Look at the rainbow!", "zh": "看彩虹！" },
        { "id": "g11-17", "text": "The flowers are pretty.", "zh": "花很漂亮。" },
